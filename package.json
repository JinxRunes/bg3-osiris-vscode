{
  "name": "bg3-osiris-vscode",
  "displayName": "Baldur's Gate 3 Osiris",
  "description": "BG3 Osiris editing and native Toolkit story compilation, forked from Divinity Engine Script Support.",
  "author": "Sebastian Lenz",
  "license": "MIT",
  "version": "0.1.1",
  "publisher": "bg3-osiris-local",
  "categories": [
    "Programming Languages"
  ],
  "icon": "resources/extension.png",
  "keywords": [
    "BG3",
    "Baldur's Gate 3",
    "Osiris",
    "Larian",
    "Story",
    "Compiler"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:divinity-story-goal",
    "onLanguage:divinity-story-div",
    "workspaceContains:**/Story/RawFiles/story_header.div",
    "workspaceContains:story_header.div",
    "workspaceContains:RawFiles/story_header.div",
    "onTaskType:bg3-osiris"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-lenz/divinity-vscode.git"
  },
  "main": "./lib/client.js",
  "contributes": {
    "configuration": {
      "title": "BG3 Osiris",
      "properties": {
        "bg3Osiris.toolkitPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Folder containing the BG3 Toolkit Osiris.dll."
        },
        "bg3Osiris.projectPath": {
          "type": "string",
          "default": "",
          "description": "Optional BG3 module folder or a folder inside it. Automatically discovered from workspace folders and open goal files when empty."
        },
        "bg3Osiris.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine-overridable",
          "description": "Python 3.10+ executable."
        },
        "bg3Osiris.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "description": ".NET 10 runtime executable for the isolated native compiler worker."
        },
        "bg3Osiris.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show syntax diagnostics while editing. Native builds provide authoritative type checking."
        }
      }
    },
    "commands": [
      {
        "command": "bg3Osiris.prepareProject",
        "title": "Prepare Project from Toolkit Build",
        "category": "BG3 Osiris"
      },
      {
        "command": "bg3Osiris.buildStory",
        "title": "Build Story",
        "category": "BG3 Osiris"
      },
      {
        "command": "bg3Osiris.showBuildOutput",
        "title": "Open Last Build Output",
        "category": "BG3 Osiris"
      },
      {
        "command": "bg3Osiris.openApiDocumentation",
        "title": "Open BG3 API Documentation",
        "category": "BG3 Osiris"
      },
      {
        "command": "bg3Osiris.refreshWorkspace",
        "title": "Refresh Project Index",
        "category": "BG3 Osiris"
      }
    ],
    "languages": [
      {
        "id": "divinity-story-goal",
        "aliases": [
          "BG3 Osiris Goal",
          "divinity-story-goal"
        ],
        "extensions": [
          ".divGoal"
        ],
        "filenamePatterns": [
          "**/Story/RawFiles/Goals/*.txt"
        ],
        "configuration": "./syntaxes/divinity-story-goal.language-configuration.json"
      },
      {
        "id": "divinity-story-div",
        "aliases": [
          "BG3 Osiris Definitions",
          "divinity-story-div"
        ],
        "extensions": [
          ".div"
        ],
        "configuration": "./syntaxes/divinity-story-div.language-configuration.json"
      },
      {
        "id": "divinity-story-log",
        "aliases": [
          "BG3 Osiris Log",
          "divinity-story-log"
        ],
        "extensions": [
          "osirislog.log"
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bg3Osiris.openApiDocumentation",
          "when": "editorLangId == divinity-story-goal",
          "group": "navigation"
        }
      ]
    },
    "grammars": [
      {
        "language": "divinity-story-div",
        "scopeName": "text.divinity.storydiv",
        "path": "./syntaxes/divinity-story-div.tmLanguage.json"
      },
      {
        "language": "divinity-story-goal",
        "scopeName": "text.divinity.storygoal",
        "path": "./syntaxes/divinity-story-goal.tmLanguage.json"
      },
      {
        "language": "divinity-story-log",
        "scopeName": "text.divinity.storylog",
        "path": "./syntaxes/divinity-story-log.tmLanguage.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "bg3-osiris",
        "owner": "bg3-osiris",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(error|warning): (.*)\\((\\d+),(\\d+)\\): (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    ],
    "snippets": [
      {
        "language": "divinity-story-goal",
        "path": "./syntaxes/divinity-story-goal.snippets.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "bg3-osiris",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "build"
            ]
          },
          "projectPath": {
            "type": "string",
            "description": "Absolute path to a BG3 module folder or a folder inside it."
          }
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "bg3Osiris.goals",
          "name": "BG3 Story Goals"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.bg3.json --noEmit",
    "test": "node --test test/bg3-*.test.cjs",
    "test:compiler": "python tools/test_bg3_osiris.py",
    "build:native": "dotnet build tools/native-worker/NativeOsirisWorker.csproj -c Release -o tools/native-worker/out --nologo",
    "vscode:prepublish": "npm run compile && npm run build:native",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing is available; native compilation requires a trusted workspace."
    },
    "virtualWorkspaces": false
  }
}
